#!/usr/bin/env python3
"""Talk to NetWatch."""

import argparse
import json
import socket
import sys

SOCKET = "/run/blackwall/netwatch.sock"


def call(request):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(SOCKET)
    except OSError as exc:
        sys.exit("netwatch is not running (%s)" % exc)
    with s:
        try:
            s.sendall((json.dumps(request) + "\n").encode("utf-8"))
            raw = _read_reply(s)
        except OSError as exc:
            sys.exit("netwatch did not answer (%s)" % exc)
        try:
            return json.loads(raw)
        except ValueError:
            sys.exit("netwatch sent an unreadable reply")


# The reply is one newline-terminated frame, and it has to be read as one.
#
# A single recv() is not a read: a stream socket hands back whatever has
# arrived, and the caller gets the rest by asking again. That was survivable
# while status was small, and stopped being survivable the moment the
# blocklist grew -- at 1328 domains the reply carries domains_list,
# blocked_live and the probe results and comes to about 80KB across two
# recv calls, so the first one returned a truncated fragment that could not
# be parsed. The daemon was answering correctly the whole time; the client
# was hanging up halfway through listening.
#
# The server has always terminated its frames with a newline. This reads to
# it, which is what makes the reply size stop mattering.
MAX_REPLY_BYTES = 64 * 1024 * 1024


def _read_reply(s):
    chunks = []
    total = 0
    while True:
        chunk = s.recv(65536)
        if not chunk:
            # The daemon hung up. Whatever arrived is all there is; let the
            # JSON parse decide whether it was a whole frame.
            break
        chunks.append(chunk)
        total += len(chunk)
        if chunk.endswith(b"\n"):
            break
        if total > MAX_REPLY_BYTES:
            # A ceiling so a wedged or misbehaving daemon cannot make the
            # client eat memory without bound. Far above any real reply.
            sys.exit("netwatch sent an oversized reply")
    return b"".join(chunks).decode("utf-8", errors="replace")


def main():
    parser = argparse.ArgumentParser(prog="netwatchctl")
    sub = parser.add_subparsers(dest="command", required=True)
    add = sub.add_parser("add", help="block a domain, permanently")
    add.add_argument("domain")
    sub.add_parser("list", help="show blocked domains")
    status = sub.add_parser("status", help="show counts")
    status.add_argument(
        "--json", action="store_true",
        help="print the status reply as one JSON object")
    log = sub.add_parser("log", help="show recent ledger entries")
    log.add_argument(
        "--limit", type=int, default=40,
        help="how many recent entries to show (default 40)")
    enforce = sub.add_parser("enforce", help="repair the managed files now")
    enforce.add_argument(
        "--close-window",
        action="store_true",
        help="finish a package transaction window once the repair has landed",
    )
    ack = sub.add_parser("ack", help="acknowledge a breach you were shown")
    ack.add_argument("token")
    args = parser.parse_args()

    if args.command == "add":
        reply = call({"cmd": "add", "domain": args.domain})
        if not reply["ok"]:
            sys.exit(reply["error"])
        print("blocked: %s" % reply["domain"])
    elif args.command == "list":
        for domain in call({"cmd": "list"})["domains"]:
            print(domain)
    elif args.command == "enforce":
        request = {"cmd": "enforce"}
        if args.close_window:
            request["close_window"] = True
        reply = call(request)
        # enforce can now be refused: --close-window is root-only. Indexing
        # ["result"] regardless would turn that refusal into a traceback.
        if not reply["ok"]:
            sys.exit(reply["error"])
        print("changed: %s" % reply["result"]["changed"])
    elif args.command == "ack":
        reply = call({"cmd": "ack", "token": args.token})
        if not reply["ok"]:
            sys.exit(reply["error"])
        print("acknowledged")
    elif args.command == "log":
        reply = call({"cmd": "log", "limit": args.limit})
        if not reply["ok"]:
            sys.exit(reply["error"])
        print(json.dumps(reply["entries"]))
    else:
        reply = call({"cmd": "status"})
        if args.json:
            print(json.dumps(reply))
        else:
            print("domains  %d" % reply["domains"])
            print("breaches %d" % reply["breaches"])
            print("failures %d" % reply["enforce_failures"])
            print("unacked  %d" % reply.get("unacknowledged", 0))
            for reason in reply.get("weakened", []):
                print("WEAK     %s" % reason)
            # A name the resolver still answers with a real address for. Not a
            # breach -- see NetWatch.sweep -- but the operator should see it.
            for domain in reply.get("leaking", []):
                print("LEAK     %s" % domain)


if __name__ == "__main__":
    main()
