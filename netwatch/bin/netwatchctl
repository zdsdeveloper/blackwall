#!/usr/bin/env python3
"""Talk to NetWatch."""

import argparse
import json
import socket
import sys

SOCKET = "/run/blackwall/netwatch.sock"


def call(request):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(SOCKET)
    except OSError as exc:
        sys.exit("netwatch is not running (%s)" % exc)
    with s:
        try:
            s.sendall((json.dumps(request) + "\n").encode("utf-8"))
            raw = s.recv(65536).decode("utf-8")
        except OSError as exc:
            sys.exit("netwatch did not answer (%s)" % exc)
        try:
            return json.loads(raw)
        except ValueError:
            sys.exit("netwatch sent an unreadable reply")


def main():
    parser = argparse.ArgumentParser(prog="netwatchctl")
    sub = parser.add_subparsers(dest="command", required=True)
    add = sub.add_parser("add", help="block a domain, permanently")
    add.add_argument("domain")
    sub.add_parser("list", help="show blocked domains")
    sub.add_parser("status", help="show counts")
    enforce = sub.add_parser("enforce", help="repair the managed files now")
    enforce.add_argument(
        "--close-window",
        action="store_true",
        help="finish a package transaction window once the repair has landed",
    )
    ack = sub.add_parser("ack", help="acknowledge a breach you were shown")
    ack.add_argument("token")
    args = parser.parse_args()

    if args.command == "add":
        reply = call({"cmd": "add", "domain": args.domain})
        if not reply["ok"]:
            sys.exit(reply["error"])
        print("blocked: %s" % reply["domain"])
    elif args.command == "list":
        for domain in call({"cmd": "list"})["domains"]:
            print(domain)
    elif args.command == "enforce":
        request = {"cmd": "enforce"}
        if args.close_window:
            request["close_window"] = True
        reply = call(request)
        # enforce can now be refused: --close-window is root-only. Indexing
        # ["result"] regardless would turn that refusal into a traceback.
        if not reply["ok"]:
            sys.exit(reply["error"])
        print("changed: %s" % reply["result"]["changed"])
    elif args.command == "ack":
        reply = call({"cmd": "ack", "token": args.token})
        if not reply["ok"]:
            sys.exit(reply["error"])
        print("acknowledged")
    else:
        reply = call({"cmd": "status"})
        print("domains  %d" % reply["domains"])
        print("breaches %d" % reply["breaches"])
        print("failures %d" % reply["enforce_failures"])
        print("unacked  %d" % reply.get("unacknowledged", 0))
        for reason in reply.get("weakened", []):
            print("WEAK     %s" % reason)


if __name__ == "__main__":
    main()
