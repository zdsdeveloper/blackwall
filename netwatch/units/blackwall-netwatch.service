[Unit]
Description=NetWatch - Blackwall integrity daemon
After=local-fs.target
# Without this, systemd's default start limit puts the unit in failed
# state after five rapid failures and leaves it there: the wall down
# permanently, needing a hand to bring it back. Retry forever instead.
StartLimitIntervalSec=0
# Armed. systemd refuses `systemctl stop` and `systemctl restart` for this unit;
# updates go through the installer, which signals it instead and lets
# Restart=always bring it back on the new code.
RefuseManualStop=yes

[Service]
Type=simple
ExecStart=/usr/local/bin/blackwall-netwatch
Restart=always
RestartSec=2
RuntimeDirectory=blackwall
# systemd removes /run/blackwall when the service stops, taking the
# pacman transaction marker with it. A restart mid-upgrade would then
# read a routine system update as tampering.
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755
StateDirectory=blackwall
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
