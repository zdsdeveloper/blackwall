# Editor and OS noise
*.bak
*.bak.*
*~
.DS_Store

# The ambience is not distributed — it is not ours to license. Drop your own
# audio into sounds/ (see sounds/README.md); anything you put there is
# ignored by git and picked up automatically by the plugin.
sounds/*
!sounds/README.md

# Byte-compiled guard, if anything ever imports it
__pycache__/
*.pyc

# The blocklist is personal and this repo is public. It lives in
# /var/lib/blackwall and must never appear here.
netwatch/**/blocklist
netwatch/**/blocklist.*
netwatch/**/ledger.jsonl
